# AI (UC-70/71/72): backend-only. Never create NEXT_PUBLIC_GEMINI_* — Gemini is
# called exclusively from the backend (vu.md, AI rule 4).
# GEMINI_API_KEY=
# GEMINI_MODEL=  (cheapest "flash" model name, per current Gemini docs; do not hard-code in code)
# Billing: fake | payos (empty = fake gateway). Set "fake" explicitly to enable /dev/fake-payment outside production.
# FRONTEND_URL builds the payment return/cancel URLs (default http://localhost:3000).
PAYMENT_PROVIDER=
FRONTEND_URL=
