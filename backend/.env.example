SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Production (Railway): NODE_ENV=production must go together with PAYMENT_PROVIDER=payos
# and all three PAYOS_* keys below; otherwise the backend refuses to start.
# NODE_ENV=production
# PORT=3001
PAYMENT_PROVIDER=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# AI: backend-only. Never create NEXT_PUBLIC_GEMINI_* — Gemini is called exclusively
# from the backend.
GEMINI_API_KEY=
GEMINI_MODEL=
# Public URL of the frontend (e.g. https://stave.netlify.app). Builds payment
# return/cancel URLs and is always allowed by CORS. Default http://localhost:3000.
FRONTEND_URL=
# Extra origins allowed by CORS and Socket.IO (/jam, /collab), comma-separated.
# Enforced only when NODE_ENV=production; other environments allow every origin.
CORS_ORIGINS=
# Number of reverse proxies in front of the backend (Railway: 1, the default in
# production). Leave empty unless the hop count differs. Never "true".
TRUST_PROXY=
# Billing sweeper (renewal reminders, grace period, scheduled plan changes).
# Set to false to turn it off. Always off when NODE_ENV=test.
BILLING_SCHEDULER_ENABLED=
# Custom Sound garbage collection (orphan files). On by default only when NODE_ENV=production;
# set CUSTOM_SOUND_GC_ENABLED=true to run it elsewhere, false to turn it off. Interval in ms
# (minimum 60000, default 21600000). Always off when NODE_ENV=test.
CUSTOM_SOUND_GC_ENABLED=
CUSTOM_SOUND_GC_INTERVAL_MS=
# Run exactly ONE backend instance: Jam state and the AI rate limiter live in memory.
